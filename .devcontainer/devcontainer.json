{
  "name": "BGES PySpark",
  "image": "quay.io/jupyter/pyspark-notebook:latest",

  "workspaceMount": "source=${localWorkspaceFolder},target=/home/jovyan/work,type=bind,consistency=cached",
  "workspaceFolder": "/home/jovyan/work",
  "remoteUser": "jovyan",

  // Variables d'environnement Spark nécessaires au kernel VSCode
  "remoteEnv": {
    "SPARK_HOME": "/usr/local/spark",
    "PYTHONPATH": "/usr/local/spark/python:/usr/local/spark/python/lib/py4j-0.10.9.9-src.zip",
    "PYSPARK_PYTHON": "/opt/conda/bin/python",
    "PYSPARK_DRIVER_PYTHON": "/opt/conda/bin/python",
    "JAVA_HOME": "/usr/local/sdkman/candidates/java/current"
  },

  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "Jupyter Lab" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "jupyter.kernels.filter": [],
        "jupyter.notebookFileRoot": "${workspaceFolder}"
      }
    }
  }
}
